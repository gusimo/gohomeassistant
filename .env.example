# GoHomeAssistant configuration. Copy to .env and fill in:  cp .env.example .env
# .env is ignored by git and docker builds; it contains your token.
# Format: KEY=value, no quotes, comments on their own lines only.

# Home Assistant URL as seen from GoHomeAssistant.
HA_URL=http://homeassistant.local:8123
# Long-lived access token: HA profile -> Security -> Long-lived access tokens.
HA_TOKEN=

# Login to the web UI: ha = with your HA account (admins only), none = no login (dev only).
GHA_AUTH=ha

# Where the web UI listens on this machine. 127.0.0.1 = only this computer;
# 0.0.0.0 = your network (then open it via this machine's IP).
GHA_BIND=127.0.0.1
GHA_PORT=8099

# Optional: HA's URL as your browser reaches it, if different from HA_URL.
GHA_HA_PUBLIC_URL=

# Optional: keep projects in a folder on this machine instead of the Docker
# volume, e.g. ./projects. File changes made outside the UI need polling then.
GHA_PROJECTS_HOST_DIR=
GHA_WATCH_POLL=

# Optional: e-mail address for git commits (author name is your HA user).
GHA_GIT_EMAIL=
